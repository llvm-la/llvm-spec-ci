# Local development environment variables.
#
# This file is ONLY for local development / debugging.  Copy to .env and adjust
# paths for your machine.  The CI pipeline does NOT read this file -- all CI
# values are declared in the Jenkinsfile `environment` block instead.
#
# Variables here mirror what Jenkinsfile sets, so the same scripts (.sh/.py)
# work unchanged whether values come from .env (local) or Jenkins (CI).
LLVM_SOURCE_DIR=/path/to/llvm-project
LLVM_BUILD_DIR=/path/to/build-llvm
BASE_COMMIT=0000000000000000000000000000000000000000

# SPEC installation directories (must contain shrc).
SPEC_CPU2006_DIR=/path/to/cpu2006
SPEC_CPU2017_DIR=/path/to/cpu2017

# SPEC build directory: where generate.py writes .cfg/.sh files,
# and where runspec/runcpu write results (also the --results-dir
# passed to collect-result.py).
SPEC_BUILD_DIR=/path/to/spec-build

# Defaults for the spec-ci.py / collect-result.py scripts (overridable via --flags).
SPEC_CI_FILE=/path/to/spec-ci.yaml
SPEC_RESULT_DIR=/path/to/spec-result
SPEC_RESULT_FILE=/path/to/result.json