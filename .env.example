# SPEC CI environment variables.
# Copy to .env and adjust paths for the current machine.
CI_ROOT=/home/llvm-spec-ci/llvm-spec-perf
LLVM_SOURCE_DIR=$CI_ROOT/repos/llvm-project
LLVM_BUILD_DIR=$CI_ROOT/build-llvm
BASE_FILE=$CI_ROOT/base-commit.txt

# Defaults for the tools/*.py scripts (overridable via --flags).
SPEC_CI_FILE=$CI_ROOT/spec-ci.yaml
SPEC_RESULT_DIR=$CI_ROOT/spec-result
SPEC_RESULT_FILE=$CI_ROOT/result.json